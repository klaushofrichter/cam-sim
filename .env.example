# cam-sim secrets. Copy to .env and `chmod 600 .env`; never commit .env.
# scripts/sync-secrets.sh fills empty values (and placeholders) and syncs them.

# Bearer token for the control API (generated when empty).
CAMSIM_CONTROL_TOKEN=
# Camera users of the deployed simulators, name:level:password;…
# Empty passwords are generated.
CAMSIM_USERS=admin:admin:;cams:admin:

# GitHub: CAMSIM_GITHUB_PAT is used as GH_TOKEN by the sync script (optional;
# otherwise gh's own login; --gh-login forces that). GITHUB_KUBE_SETUP_PAT is
# synced as the repository secret KUBE_SETUP_DEPLOY_TOKEN (GitHub refuses
# names starting with GITHUB_) for the deploy workflow.
CAMSIM_GITHUB_PAT=
GITHUB_KUBE_SETUP_PAT=
GITHUB_REPO=klaushofrichter/cam-sim

# Kubernetes target for the Secret (no default context on purpose).
KUBE_CONTEXT=
KUBE_NAMESPACE=cam-sim
KUBE_SECRET=cam-sim-secrets
# Admin credentials for the certificate push CronJob (username, password).
KUBE_CAMERA_SECRET=cam2-camera-credentials

# The real camera's admin password, for scripts/capture-clip.py, which reads
# REOLINK_IP and REOLINK_PASSWORD from ~/Development/reolink/.env, not from
# this file. Nothing in cam-sim itself reads this entry.
# Never synced anywhere.
REOLINK_PASSWORD=
